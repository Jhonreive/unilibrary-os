# UniLibrary OS - environment configuration
# Copy this file to ".env" and fill in real values. NEVER commit ".env".
# For production, keep the real file OUTSIDE the web root and point to it with
# the server variable ULIB_ENV_FILE=/path/to/ulibrary.env

# development | production
APP_ENV=production
# true only on your own machine; shows real error details on screen
APP_DEBUG=false

# --- Database (use a dedicated least-privilege user, NOT root) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ulibrary
DB_USER=ulibrary_app
DB_PASS=change-me

# --- Web security ---
# Comma-separated hostnames this app may be served from (blocks Host-header attacks). Empty = allow any.
APP_ALLOWED_HOSTS=library.example.edu
# Comma-separated frontend origins allowed to call this server cross-origin. Empty = same-origin only.
CORS_ALLOWED_ORIGINS=
# Set to 1 ONLY if you sit behind a reverse proxy/load balancer you control (trusts X-Forwarded-Proto / -For)
TRUSTED_PROXY=0
# Minutes of inactivity before a session expires, and the hard maximum session age in hours
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=8

# --- One-time account bootstrap (setup.php) ---
# 0 = setup.php is disabled (default). Set to 1 briefly, only from the server itself, then set back to 0 and delete the file.
ENABLE_SETUP=0
